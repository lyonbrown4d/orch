// Integration smoke: lightweight workload placement, migration, rebalance, and failover.
// The smoke script starts a 3-node orch cluster and deploys this file via orch-cli.

app {
  name = "placement-smoke"
  namespace = "default"

  docker {
    network = "orch-raft-placement-smoke"
  }

  volume whoamiData {
    persistent = true
  }

  service whoami {
    image = "traefik/whoami:v1.11"
    preferred_nodes = ["node-b"]

    mount {
      volume = "whoamiData"
      target = "/tmp/orch-data"
    }

    http(80)
  }

  ingress public {
    path "/" {
      workload = whoami
    }
  }
}