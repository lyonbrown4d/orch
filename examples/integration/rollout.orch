// Integration smoke: rollout auto-rollback happy baseline.
// The smoke script starts a 3-node orch cluster, deploys this file, then applies rollout-broken.orch.

app {
  name = "rollout-smoke"
  namespace = "default"

  docker {
    network = "orch-raft-rollout-smoke"
  }

  service whoami {
    image = "traefik/whoami:v1.11"
    preferred_nodes = ["node-b"]

    http(80)
    health {
      readiness {
        http = "/"
        endpoint = "http"
        interval = "1s"
        timeout = "500ms"
        retries = 60
      }
    }

    rollout {
      strategy = "rolling"
      max_unavailable = 1
      rollback_on_failure = true
      progress_deadline = "20s"
    }
  }

  ingress public {
    path "/" {
      workload = whoami
    }
  }
}
